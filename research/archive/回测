import pandas as pd
from pathlib import Path
p = Path('data/cache/max/SPY.parquet')
df = pd.read_parquet(p)
s = df['Close'].copy()
s.index = pd.DatetimeIndex(s.index).tz_localize(None).normalize()
s = s[~s.index.duplicated(keep='last')].sort_index()
print('SPY', s.index[0].date(), '->', s.index[-1].date(), 'n=', len(s))
print('last', float(s.iloc[-1]))

def cagr(a, b, days):
    years = days / 365.25
    if years <= 0 or a <= 0:
        return None
    return (b/a)**(1/years) - 1

def window(start, end=None):
    sl = s.loc[start:] if end is None else s.loc[start:end]
    if sl.empty:
        print(start, end, 'EMPTY')
        return
    days = (sl.index[-1] - sl.index[0]).days
    ret = sl.iloc[-1]/sl.iloc[0] - 1
    dd = (sl/sl.cummax() - 1).min()
    print(f'{sl.index[0].date()} -> {sl.index[-1].date()}  years={days/365.25:.1f}  total={ret:+.1%}  CAGR={cagr(sl.iloc[0], sl.iloc[-1], days):+.1%}  maxDD={dd:.1%}  start={sl.iloc[0]:.2f} end={sl.iloc[-1]:.2f}')

windows = [
    ('1993-01-29', None),
    ('2000-01-01', None),
    ('2000-01-01', '2009-12-31'),
    ('2007-04-11', None),  # HYG start, full regime
    ('2007-04-11', '2009-12-31'),
    ('2010-01-01', '2018-12-31'),
    ('2013-01-01', '2018-12-31'),
    ('2019-01-01', None),
    ('2019-01-01', '2022-12-31'),
    ('2023-01-01', None),
    ('2022-01-01', '2022-12-31'),
    ('2000-01-01', '2018-12-31'),
]
for a,b in windows:
    window(a,b)

# calendar decades
print('--- decades ---')
for y0 in range(1993, 2027, 1):
    sl = s.loc[str(y0):str(y0)]
    if len(sl) < 2:
        continue
    print(f'{y0}  {sl.iloc[-1]/sl.iloc[0]-1:+.1%}')
