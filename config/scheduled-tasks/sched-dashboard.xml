<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <!-- Login autostart for the P1 read-only dashboard.
       Binds 127.0.0.1:8600 only (never 0.0.0.0). Does not trade.
       pythonw.exe: no console flash. ExecutionTimeLimit PT0S = run until logoff.
       This file is shipped unregistered. To install, from an elevated-or-same-user prompt:
         schtasks /Create /TN "AgenticTradingDashboard" /XML "C:\Users\helow\Documents\Trading\config\scheduled-tasks\sched-dashboard.xml"
       Add /F only if you intend to replace an existing task of that name. -->
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Delay>PT15S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\helow\Documents\Trading\.venv\Scripts\pythonw.exe</Command>
      <Arguments>-m agentic_trading.dashboard.api --host 127.0.0.1 --port 8600</Arguments>
      <WorkingDirectory>C:\Users\helow\Documents\Trading</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
