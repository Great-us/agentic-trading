# Copy this file to .env and fill in real values. Never commit .env.

# Alpaca paper trading - https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Analyst backend -------------------------------------------------------
# "cli" spends an existing coding-plan subscription via a local agent CLI.
# "api" uses a pay-per-token developer key (MOONSHOT_API_KEY below).
#
# Scheduled/unattended use conflicts with the Kimi Code subscription's
# Community Guidelines. Claude Code officially supports non-interactive -p
# automation, so it is the recommended CLI backend for this scheduled system.
# See research/model-architecture-research-2026-08-22.md section 1.
ANALYST_PROVIDER=cli
ANALYST_CLI_PATH=C:\Users\<you>\AppData\Roaming\npm\claude.cmd
ANALYST_CLI_TIMEOUT=300

# Pin the coding model used by scheduled analysis. "sonnet" is the practical
# default; use "opus" only if its higher quota consumption is acceptable.
ANALYST_CLI_MODEL=sonnet

# Kimi Code-only config-home override. Leave blank for Claude Code.
ANALYST_CLI_HOME=

# Claude Code: pin effort and expose zero built-in tools, MCP servers, skills,
# or slash commands. --verbose is required by current Claude Code whenever
# --print is combined with --output-format stream-json.
ANALYST_CLI_EXTRA_ARGS=--effort high --tools "" --verbose --strict-mcp-config --disable-slash-commands --no-session-persistence

# Only used when ANALYST_PROVIDER=api. Must be a developer key from the open
# platform (platform.moonshot.ai); a Kimi Code subscription key will 401 here.
MOONSHOT_API_KEY=
ANALYST_MODEL=kimi-k3

# --- Grok sentiment confirmation gate -------------------------------------
# Optional final check right before a BUY/SELL executes: live X/web sentiment,
# via Grok CLI (grok.com login). Off by default; see README "Grok sentiment
# gate" before enabling. Real USD cost per call (~$0.06 observed), not
# subscription quota.
GROK_ENABLED=false
GROK_CLI_PATH=
GROK_TIMEOUT_SECONDS=60
GROK_REASONING_EFFORT=low

# --- Free point-in-time backtest data --------------------------------------
# Existing Alpaca credentials above also supply adjusted SIP history for
# historical/delisted S&P 500 names that Yahoo no longer serves. Tiingo is an
# optional final fallback and its monthly unique-symbol quota is never evaded.
# Alpha Vantage is used only for the bulk listing-status cross-check.
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
